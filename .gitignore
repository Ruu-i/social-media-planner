node_modules/
.env
dist/
out/
*.log

# never commit key backups
.env.*
!.env.example

# Uploaded photos and videos — user data, never commit.
# Anchored with a leading slash: a bare `media/` also matches src/media/,
# which silently excluded real source files.
/media/

# vite build output
web/dist/

.ddb-local/

# Lambda build output — regenerate with npm run build:lambda
dist-lambda/

# Terraform: local state and the provider cache.
# State describes the live stack and can hold resource values in plaintext;
# the .terraform dir is hundreds of MB of downloaded providers.
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/*.tfvars

# TypeScript incremental build info
*.tsbuildinfo
