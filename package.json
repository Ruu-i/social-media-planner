{
  "name": "social-media-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI agent that researches, plans, and drafts social media content.",
  "scripts": {
    "agent": "tsx src/cli.ts",
    "verify": "tsx src/verify.ts",
    "typecheck": "tsc --noEmit",
    "api": "tsx watch src/server/index.ts",
    "web": "npm --prefix web run dev",
    "web:install": "npm --prefix web install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}