# The API origin, baked into the production bundle at build time.
#
# Lives in a file rather than being passed on the command line because an
# inline env var is invisible when it is MISSING: the build succeeds, the
# bundle calls /api on its own origin, CloudFront answers every path with
# index.html, and the app dies on "Unexpected token '<'" at runtime. Vite reads
# this automatically for `vite build`, so there is no command to remember.
#
# Not a secret — a public endpoint, deliberately committed.
VITE_API_BASE=https://jwm4fzulimxfktq7jgimenxf4u0mzpfo.lambda-url.us-east-1.on.aws
