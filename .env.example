# Get a key from https://console.anthropic.com/settings/keys
# Copy this file to .env and paste your key in.
#
# Paste it exactly — no quotes, no trailing full stop. A stray character makes
# the key look completely normal and fail with an opaque 401.
ANTHROPIC_API_KEY=sk-ant-...

# Planning effort: high (default, better copy) or medium (~23% faster).
# MODEL_EFFORT=medium
