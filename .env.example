# Get a key from https://console.anthropic.com/settings/keys
# Copy this file to .env and paste your key in.
#
# Paste it exactly — no quotes, no trailing full stop. A stray character makes
# the key look completely normal and fail with an opaque 401.
ANTHROPIC_API_KEY=sk-ant-...

# Planning effort: high (default, better copy) or medium (~23% faster).
# MODEL_EFFORT=medium

# --- Provider -------------------------------------------------------------
# Leave unset to use the Anthropic API with the key above.
#
# Set to "bedrock" to route inference through AWS Bedrock instead. Bedrock needs
# an AWS ACCOUNT, not AWS hosting — this can run on your laptop. Credentials come
# from the normal AWS chain (env vars, ~/.aws/credentials, or in a Lambda the
# execution role), so nothing else goes in this file.
#
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
